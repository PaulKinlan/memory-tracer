# Dependencies
node_modules/

# Audit output — large, regenerable, and heap snapshots can embed page
# content; keep them local, publish only aggregates. (testplans/ stays
# tracked by design: plans are reviewed and reused across runs.)
reports/
*.heapsnapshot

# Agent scratch space — ad-hoc helper scripts/screenshots written mid-audit
# (the memory-audit skill directs agents here)
scratch/

# Local secrets / environment
.env
.env.*

# Logs
*.log
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db
